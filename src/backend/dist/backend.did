type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type StreakSummary = 
 record {
   checkedInToday: bool;
   current: opt Streak;
   logs: vec StreakLog;
   longestStreakSeconds: nat;
   milestones: vec Milestone;
   totalCleanSeconds: nat;
 };
type StreakLog = 
 record {
   durationSeconds: nat;
   endedAt: Timestamp;
   id: nat;
   startedAt: Timestamp;
   triggers: vec text;
 };
type Streak = 
 record {
   lastCheckInAt: opt Timestamp;
   startedAt: Timestamp;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Milestone = 
 record {
   days: nat;
   earned: bool;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  checkInToday: () -> (StreakSummary);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getStreakSummary: () -> (StreakSummary);
  isCallerAdmin: () -> (bool) query;
  relapse: (triggers: vec text) -> (StreakSummary);
  schema: () -> (text) query;
  startStreak: () -> (StreakSummary);
}
